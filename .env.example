# Copia este archivo a .env y pon tu token de @BotFather (sin comillas, sin espacios)
TELEGRAM_BOT_TOKEN=
# API de descargas (opcional; sin key propia usa la pública con poco saldo)
ALYACORE_API_URL=https://api.alyacore.xyz
ALYACORE_API_KEY=
# Telegram sin servidor local deja subir hasta ~50 MB
MAX_DOWNLOAD_BYTES=2147483648
# NSFW (default true). false desactiva /xnxx /r34 etc.
NSFW_ENABLED=true
# --- Modo 2 GB (npm run start2gb): de https://my.telegram.org → API development tools ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# --- Modo 2 GB SIN servidor extra (npm start normal): con TELEGRAM_API_ID y TELEGRAM_API_HASH
# el bot sube archivos hasta ~1950 MB por MTProto. Sin ellas, sigue con 49 MB.
# MTPROTO_UPLOAD=false lo desactiva.
